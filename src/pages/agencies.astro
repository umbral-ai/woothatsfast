---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Shadow from "@/components/global/Shadow.astro";
import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/Navigation.astro";

const benefits = [
  {
    title: "White Label Partnership",
    description: "We work seamlessly as your dedicated development team, maintaining your brand identity throughout all client interactions."
  },
  {
    title: "Dedicated Resources",
    description: "Get priority access to our expert developers for your client projects with guaranteed availability."
  },
  {
    title: "Technical Excellence",
    description: "Leverage our deep expertise in WooCommerce, WordPress, and ecommerce optimization."
  },
  {
    title: "Scalable Support",
    description: "Scale your agency's capabilities without the overhead of hiring full-time developers."
  }
];

const services = [
  {
    title: "Development Services",
    features: [
      "Custom WooCommerce development",
      "Theme customization",
      "Plugin development",
      "Performance optimization",
      "API integrations",
      "Payment gateway setup"
    ]
  },
  {
    title: "Technical Support",
    features: [
      "24/7 emergency support",
      "Regular maintenance",
      "Security updates",
      "Performance monitoring",
      "Technical consulting",
      "Code reviews"
    ]
  },
  {
    title: "Project Management",
    features: [
      "Dedicated project manager",
      "Clear communication",
      "Regular updates",
      "Timeline management",
      "Resource allocation",
      "Quality assurance"
    ]
  }
];

const process = [
  {
    title: "Partnership Setup",
    description: "Quick onboarding process to understand your agency's needs and establish communication channels."
  },
  {
    title: "Resource Allocation",
    description: "Dedicated team members assigned to your agency with guaranteed availability."
  },
  {
    title: "Project Execution",
    description: "Seamless delivery of projects with regular updates and clear communication."
  },
  {
    title: "Ongoing Support",
    description: "Continuous support and maintenance to ensure long-term success."
  }
];
---

<BaseLayout>
  <section class="relative overflow-hidden">
    <Shadow />
    <div class="p-8 lg:px-44 lg:py-24 2xl:px-24 relative">
      <Navigation />
      
      <!-- Intro Section -->
      <div class="flex flex-col gap-12 mt-12">
        <div class="border p-8 border-dashed border-zinc-300 dark:border-zinc-700">
          <div class="flex items-center gap-2 text-black dark:text-white">
            <div class="size-2 rounded-lg bg-green-500 animate-pulse"></div>
            <Text
              tag="p"
              variant="textSM"
              class="text-black dark:text-white"
            >
              Agency Partnerships
            </Text>
          </div>
          <Text
            tag="h1"
            variant="displayLG"
            class="text-black dark:text-white tracking-wide text-balance font-serif italic"
          >
            Your Dedicated WooCommerce Development Team
          </Text>
          <Text
            variant="textLG"
            class="text-zinc-500 dark:text-zinc-400 mt-4 text-pretty max-w-2xl"
          >
            Scale your agency's capabilities with our expert WooCommerce development team. We work as an extension of your agency, delivering high-quality solutions for your clients.
          </Text>
        </div>

        <!-- Benefits Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 p-8 border-x border-dashed border-zinc-300 dark:border-zinc-700">
          {benefits.map((item) => (
            <div>
              <Text
                tag="h3"
                variant="textBase"
                class="text-black dark:text-white block font-semibold"
              >
                {item.title}
              </Text>
              <Text
                tag="p"
                variant="textBase"
                class="text-zinc-500 dark:text-zinc-400 text-pretty"
              >
                {item.description}
              </Text>
            </div>
          ))}
        </div>

        <!-- Services Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {services.map((service) => (
            <div class="border border-dashed p-8 border-zinc-300 dark:border-zinc-700">
              <Text
                tag="h3"
                variant="displayXS"
                class="font-serif italic text-black dark:text-white"
              >
                {service.title}
              </Text>
              <ul class="mt-6 space-y-2">
                {service.features.map((feature) => (
                  <li class="flex items-center gap-2 text-zinc-500 dark:text-zinc-400">
                    <div class="ring-1 ring-zinc-200 dark:ring-zinc-700 p-[0.110rem] bg-white/5 shadow rounded-sm">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="icon icon-tabler icons-tabler-outline icon-tabler-check size-2.5"
                      >
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M5 12l5 5l10 -10" />
                      </svg>
                    </div>
                    <Text variant="textSM">
                      {feature}
                    </Text>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- Process Section -->
        <div class="border p-8 border-dashed border-zinc-300 dark:border-zinc-700">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-serif italic text-black dark:text-white"
          >
            Partnership Process
          </Text>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mt-8">
            {process.map((item, index) => (
              <div>
                <Text
                  tag="h3"
                  variant="textBase"
                  class="text-black dark:text-white block font-semibold"
                >
                  {index + 1}. {item.title}
                </Text>
                <Text
                  tag="p"
                  variant="textBase"
                  class="text-zinc-500 dark:text-zinc-400 mt-2"
                >
                  {item.description}
                </Text>
              </div>
            ))}
          </div>
        </div>

        <!-- CTA Section -->
        <div class="border p-8 border-dashed border-zinc-300 dark:border-zinc-700">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-serif italic text-black dark:text-white"
          >
            Ready to scale your agency?
          </Text>
          <Text
            variant="textSM"
            class="text-zinc-500 dark:text-zinc-400 mt-4"
          >
            Let's discuss how we can help your agency deliver exceptional WooCommerce solutions to your clients.
          </Text>
          <div class="mt-8">
            <Text
              tag="a"
              href="#schedule"
              variant="textSM"
              class="inline-block bg-black text-white dark:bg-white dark:text-black px-6 py-3 hover:bg-zinc-800 dark:hover:bg-zinc-200 duration-200"
            >
              Schedule Partnership Call
            </Text>
          </div>
        </div>
      </div>

      <Footer />
    </div>
  </section>
</BaseLayout>
