---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Shadow from "@/components/global/Shadow.astro";
import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/Navigation.astro";

const toolCategories = [
  {
    title: "Ecommerce Solutions",
    description: "Enterprise-grade ecommerce platforms we specialize in",
    tools: [
      {
        name: "WooCommerce",
        description: "Core platform optimization & custom development",
        features: [
          "Performance optimization",
          "Custom checkout flows",
          "Payment gateway integration",
          "Inventory management",
          "Shipping solutions",
          "API integrations"
        ]
      },
      {
        name: "SureCart",
        description: "Modern, lightweight ecommerce solution",
        features: [
          "Fast checkout experience",
          "Subscription management",
          "Digital product delivery",
          "Custom payment flows",
          "Integration with existing sites",
          "Optimized performance"
        ]
      }
    ]
  },
  {
    title: "Content Management",
    description: "Advanced content management and customization tools",
    tools: [
      {
        name: "Advanced Custom Fields Pro",
        description: "Flexible content management solution",
        features: [
          "Custom field types",
          "Flexible content layouts",
          "Repeater fields",
          "Options pages",
          "Block editor integration",
          "Performance optimization"
        ]
      },
      {
        name: "Meta Box",
        description: "Professional field and custom post type manager",
        features: [
          "Custom post types",
          "Custom taxonomies",
          "Relationship fields",
          "Conditional logic",
          "Front-end submission",
          "API integration"
        ]
      }
    ]
  },
  {
    title: "Form Solutions",
    description: "Enterprise-grade form management systems",
    tools: [
      {
        name: "Gravity Forms",
        description: "Advanced form management system",
        features: [
          "Complex form logic",
          "Payment integration",
          "User registration",
          "File uploads",
          "Multi-page forms",
          "API connections"
        ]
      },
      {
        name: "Additional Form Providers",
        description: "Support for various form solutions",
        features: [
          "WPForms integration",
          "Formidable Forms",
          "Fluent Forms",
          "Custom form development",
          "Form optimization",
          "Data management"
        ]
      }
    ]
  }
];

const benefits = [
  {
    title: "Clean Architecture",
    description: "Our implementations focus on maintainable, well-documented solutions that your team can easily manage."
  },
  {
    title: "Performance Focused",
    description: "Every tool is optimized for maximum performance while maintaining full functionality."
  },
  {
    title: "Team Friendly",
    description: "Built with team collaboration in mind, making it easy for multiple developers to work together."
  },
  {
    title: "Future Proof",
    description: "Solutions that scale with your business and adapt to changing technologies."
  }
];
---

<BaseLayout>
  <section class="relative overflow-hidden">
    <Shadow />
    <div class="p-8 lg:px-44 lg:py-24 2xl:px-24 relative">
      <Navigation />
      
      <!-- Intro Section -->
      <div class="flex flex-col gap-12 mt-12">
        <div class="border p-8 border-dashed border-zinc-300 dark:border-zinc-700">
          <div class="flex items-center gap-2 text-black dark:text-white">
            <div class="size-2 rounded-lg bg-green-500 animate-pulse"></div>
            <Text
              tag="p"
              variant="textSM"
              class="text-black dark:text-white"
            >
              Tools & Technologies
            </Text>
          </div>
          <Text
            tag="h1"
            variant="displayLG"
            class="text-black dark:text-white tracking-wide text-balance font-serif italic"
          >
            Enterprise-Grade Tools, Optimized for Performance
          </Text>
          <Text
            variant="textLG"
            class="text-zinc-500 dark:text-zinc-400 mt-4 text-pretty max-w-2xl"
          >
            We work with industry-leading tools and technologies to create robust, maintainable solutions that your team will love working with.
          </Text>
        </div>

        <!-- Benefits Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 p-8 border-x border-dashed border-zinc-300 dark:border-zinc-700">
          {benefits.map((item) => (
            <div>
              <Text
                tag="h3"
                variant="textBase"
                class="text-black dark:text-white block font-semibold"
              >
                {item.title}
              </Text>
              <Text
                tag="p"
                variant="textBase"
                class="text-zinc-500 dark:text-zinc-400 text-pretty"
              >
                {item.description}
              </Text>
            </div>
          ))}
        </div>

        <!-- Tools Categories -->
        {toolCategories.map((category) => (
          <div class="border p-8 border-dashed border-zinc-300 dark:border-zinc-700">
            <Text
              tag="h2"
              variant="displaySM"
              class="font-serif italic text-black dark:text-white"
            >
              {category.title}
            </Text>
            <Text
              variant="textSM"
              class="text-zinc-500 dark:text-zinc-400 mt-2"
            >
              {category.description}
            </Text>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
              {category.tools.map((tool) => (
                <div class="border border-dashed p-6 border-zinc-300 dark:border-zinc-700">
                  <Text
                    tag="h3"
                    variant="textLG"
                    class="text-black dark:text-white font-semibold"
                  >
                    {tool.name}
                  </Text>
                  <Text
                    variant="textSM"
                    class="text-zinc-500 dark:text-zinc-400 mt-2"
                  >
                    {tool.description}
                  </Text>
                  <ul class="mt-4 space-y-2">
                    {tool.features.map((feature) => (
                      <li class="flex items-center gap-2 text-zinc-500 dark:text-zinc-400">
                        <div class="ring-1 ring-zinc-200 dark:ring-zinc-700 p-[0.110rem] bg-white/5 shadow rounded-sm">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="icon icon-tabler icons-tabler-outline icon-tabler-check size-2.5"
                          >
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M5 12l5 5l10 -10" />
                          </svg>
                        </div>
                        <Text variant="textSM">
                          {feature}
                        </Text>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))}

        <!-- Integration CTA -->
        <div class="border p-8 border-dashed border-zinc-300 dark:border-zinc-700">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-serif italic text-black dark:text-white"
          >
            Need a custom integration?
          </Text>
          <Text
            variant="textSM"
            class="text-zinc-500 dark:text-zinc-400 mt-4"
          >
            We specialize in creating custom integrations and optimizing existing tools for maximum performance and maintainability.
          </Text>
          <div class="mt-8">
            <Text
              tag="a"
              href="#schedule"
              variant="textSM"
              class="inline-block bg-black text-white dark:bg-white dark:text-black px-6 py-3 hover:bg-zinc-800 dark:hover:bg-zinc-200 duration-200"
            >
              Discuss Your Project
            </Text>
          </div>
        </div>
      </div>

      <Footer />
    </div>
  </section>
</BaseLayout>
